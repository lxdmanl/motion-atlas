{
  "name": "motion-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 3016 --strictPort",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "build:vercel": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:pose": "node scripts/setup-pose.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.159.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.159.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.5",
    "meshoptimizer": "^1.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "5.0.3"
  },
  "type": "module",
  "license": "MIT"
}
